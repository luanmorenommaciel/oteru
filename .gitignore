# Secrets / local environment — never commit credentials.
.env
__pycache__/
*.py[cod]

# Local scratch — screenshots, generated PDFs, one-off scripts. These are not
# shared artifacts: if something here is worth keeping, give it a real home
# under docs/ instead of letting it sit in everyone's `git status`.
tmp/
output/
__pycache__/
.tmp_palestra/
/*.png

# Claude Code local settings and policy may contain machine-specific paths or
# operational rules; the shareable `settings.json` remains tracked.
.claude/settings.local.json
.claude/oteru-policy.local.json

# Local Python execution artifacts.
__pycache__/
# Python bytecode
*.pyc
