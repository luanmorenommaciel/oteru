# Copy to .env (gitignored) and fill in — NEVER commit real values.
# From inside the container, "localhost" on the host is host.docker.internal.

# HMAC key for the OTTL HMACSHA256 converter (hmacconverter). Empty here on
# purpose: there is no default and the Collector refuses to start without it.
# It must be exactly 64 lowercase hex characters. Generate one with:
#   python -c 'import secrets;print(secrets.token_hex(32))'
# The Collector reads it only from the environment at runtime. Never put a
# real value in this file, the Makefile, an image layer, logs or argv.
OTERU_PII_HMAC_KEY=
CLICKSTACK_ENDPOINT=http://host.docker.internal:4318
CLICKSTACK_API_KEY=your-hyperdx-ingestion-api-key

# For make up-direct / make up-clickstack-local (local ClickStack all-in-one).
# `make up-direct` bootstraps this automatically; or get the key from the HyperDX
# UI (Team Settings) or: docker exec oteru-collector-hyperdx-1 mongosh --quiet hyperdx --eval 'db.teams.findOne().apiKey'
HYPERDX_API_KEY=your-local-hyperdx-ingestion-api-key
