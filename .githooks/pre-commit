#!/bin/sh
# PII guard — blocks commits containing un-redacted captures or cleartext
# identifiers in chargeback seeds (#46). Prefer python3 (macOS/Linux have no
# bare `python`); fall back to `python`.
ROOT="$(git rev-parse --show-toplevel)"
PY="$(command -v python3 || command -v python)"
"$PY" "$ROOT/scripts/check_pii.py" || exit $?
exec "$PY" "$ROOT/scripts/check_chargeback_seeds.py"
